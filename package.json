{
  "name": "image-flattener",
  "private": true,
  "version": "1.0.0",
  "description": "Client-side image flattener: N-color PNG + layered SVG for multi-color 3D printing",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:server": "VITE_SELF_HOSTED=1 vite build",
    "preview": "vite preview",
    "serve": "node server/server.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "earcut": "^3.2.4",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vite": "^8.0.0",
    "vitest": "^4.1.11"
  }
}
